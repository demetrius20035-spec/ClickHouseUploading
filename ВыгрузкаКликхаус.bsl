&НаСервере
Функция КХ_УдалитьДанные(МассивСтруктур, ИмяТаблицы, ПолеОтбора)
	ДанныеАвторизации = КХ_ПолучитьДанныеАвторизации();
	Пользователь = ДанныеАвторизации.Пользователь;
	Пароль = ДанныеАвторизации.Пароль;
	
	СписокСсылок = Новый Массив;
	Для Каждого Струк Из МассивСтруктур Цикл
		Если Струк.Свойство(ПолеОтбора) Тогда
			Ссылка = Струк[ПолеОтбора];
			Если ЗначениеЗаполнено(Ссылка) Тогда
				ЭскСсылка = СтрЗаменить(Ссылка, "'", "''");
				СписокСсылок.Добавить("'" + ЭскСсылка + "'");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если СписокСсылок.Количество() = 0 Тогда
		Возврат 200; 
	КонецЕсли;
	
	СтрокаСсылок = СтрСоединить(СписокСсылок, ", ");
	
	ЗапросSQL = "ALTER TABLE " + ИмяТаблицы + 
	" DELETE WHERE " + ПолеОтбора + " IN (" + СтрокаСсылок + ") " +
	"SETTINGS mutations_sync = 2, max_execution_time = 0";
	
	ДанныеХостПорт = КХ_ПолучитьХостПорт();
	Хост = ДанныеХостПорт.Host;
	Порт = ДанныеХостПорт.Port;
	
	Путь = "/?user=" + Пользователь + "&password=" + Пароль;
	Ответ = ОтправитьHTTP(Хост, Порт, Путь, ЗапросSQL);
	
	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("======ОШИБКА УДАЛЕНИЯ========(Ответ.КодСостояния = " + Ответ.КодСостояния +")");
		Сообщить("======ТелоОтвета = " + Ответ.ПолучитьТелоКакСтроку());
		//Сообщить("======СтрокаJSON = " + СтрокаJSON);
		Сообщить("======ИмяТаблицы = " + ИмяТаблицы);
	КонецЕсли;
	Возврат Ответ.КодСостояния;
	
КонецФункции

&НаСервере
Функция КХ_ОтправитьДанные(СтрокаJSON, ИмяТаблицы) 
	
	ДанныеАвторизации = КХ_ПолучитьДанныеАвторизации();
	Пользователь = ДанныеАвторизации.Пользователь;
	Пароль = ДанныеАвторизации.Пароль;
	
	ЗапросSQL = "INSERT INTO " + ИмяТаблицы + " SETTINGS async_insert = 1, wait_for_async_insert = 1, input_format_parallel_parsing = 1 FORMAT JSONEachRow";
	ЗакодированныйЗапрос = КХ_ЗакодироватьURL(ЗапросSQL);
	
	ДанныеХостПорт = КХ_ПолучитьХостПорт();
	Хост = ДанныеХостПорт.Host;
	Порт = ДанныеХостПорт.Port;
	
	Путь = "/?query=" + ЗакодированныйЗапрос + "&user=" + Пользователь + "&password=" + Пароль;
	
	Ответ = ОтправитьHTTP(Хост, Порт, Путь, СтрокаJSON);
	
	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("======ОШИБКА ОТПРАВКИ========(Ответ.КодСостояния = " + Ответ.КодСостояния +")");
		Сообщить("======ТелоОтвета = " + Ответ.ПолучитьТелоКакСтроку());
		//Сообщить("======СтрокаJSON = " + СтрокаJSON);
		Сообщить("======ИмяТаблицы = " + ИмяТаблицы);
	КонецЕсли;
	
	Возврат Ответ.КодСостояния;
КонецФункции

&НаСервере
Функция КХ_ЗакодироватьURL(Знач СтрокаДляКодирования)
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "%", "%25");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, " ", "%20");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "!", "%21");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "#", "%23");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "$", "%24");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "&", "%26");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "'", "%27");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "(", "%28");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ")", "%29");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "*", "%2A");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "+", "%2B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ",", "%2C");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "/", "%2F");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ":", "%3A");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ";", "%3B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "=", "%3D");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "?", "%3F");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "@", "%40");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "[", "%5B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "]", "%5D");
	Возврат СтрокаДляКодирования;
КонецФункции

