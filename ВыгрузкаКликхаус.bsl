&НаСервере
Функция КХ_ПолучитьСсылкиИзБазы_АУ(ТипМетаданных, ПараметрыЗапроса) 
	
	МассивСтруктур = Новый Массив;
	
	Если Метаданные.Справочники.Содержит(ТипМетаданных) ИЛИ Метаданные.Документы.Содержит(ТипМетаданных) Тогда
		
		ИмяМетаданныхСтрока = ТипМетаданных.Имя;
		Если Метаданные.Справочники.Содержит(ТипМетаданных) Тогда
			ТипМетаданныхСтрока = "Справочник";
		ИначеЕсли Метаданные.Документы.Содержит(ТипМетаданных) Тогда 
			ТипМетаданныхСтрока = "Документ";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "Выбрать АудиторскийСлед.Объект КАК Ссылка
		|		ПОМЕСТИТЬ ВременнаяТаблица
		|	ИЗ Справочник.АудиторскийСлед КАК АудиторскийСлед
		|	ГДЕ
		|	 АудиторскийСлед.Дата МЕЖДУ &ДатаПериодаОт И &ДатаПериодаДо
		|	 И АудиторскийСлед.Объект ССЫЛКА " + ТипМетаданныхСтрока + "." + ИмяМетаданныхСтрока + "
		|	 И АудиторскийСлед.Объект.Ссылка ЕСТЬ НЕ NULL
		|	СГРУППИРОВАТЬ ПО
		|	 АудиторскийСлед.Объект
		|	
		|	 ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|	 " + ИмяМетаданныхСтрока + ".Ссылка
		|	ИЗ
		|	 " + ТипМетаданныхСтрока + "." + ИмяМетаданныхСтрока + " КАК " + ИмяМетаданныхСтрока + "
		|	ГДЕ
		|	 " + ИмяМетаданныхСтрока + ".ДатаСоздания ЕСТЬ НЕ NULL
		|	 И " + ИмяМетаданныхСтрока + ".ДатаСоздания МЕЖДУ &ДатаСозданияОт И &ДатаСозданияДо
		|	;
		|	
		|	////////////////////////////////////////////////////////////////////////////////
		|	ВЫБРАТЬ
		|	 ВременнаяТаблица.Ссылка КАК Ссылка
		|	ИЗ
		|	 ВременнаяТаблица КАК ВременнаяТаблица
		|	СГРУППИРОВАТЬ ПО
		|	 ВременнаяТаблица.Ссылка";
		
		Запрос.УстановитьПараметр("ДатаПериодаОт", ПараметрыЗапроса.ПериодОт);
		Запрос.УстановитьПараметр("ДатаПериодаДо", ПараметрыЗапроса.ПериодДо);
		
		Запрос.УстановитьПараметр("ДатаСозданияОт", ПараметрыЗапроса.ПериодОт);
		Запрос.УстановитьПараметр("ДатаСозданияДо", ПараметрыЗапроса.ПериодДо);
		
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выгрузка = Результат.Выгрузить();
		Иначе
			Возврат МассивСтруктур;
		КонецЕсли;
		
		Для Каждого ТекСтрока Из Выгрузка Цикл
			СтруктураЗаписи = Новый Структура; 
			
			Для Каждого Колонка Из Выгрузка.Колонки Цикл
				ИмяКолонки = Колонка.Имя;
				ЗначениеЯчейки = ТекСтрока[ИмяКолонки];
				НазваниеПоля = КХ_ТранслитерироватьСтроку(ИмяКолонки);
				
				Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
					ЗначениеПоля = КХ_ПреобразоватьЗначение(ЗначениеЯчейки);
				Иначе
					ЗначениеПоля = Неопределено;
				КонецЕсли;
				
				СтруктураЗаписи.Вставить(НазваниеПоля, ЗначениеПоля);
			КонецЦикла;
			
			МассивСтруктур.Добавить(СтруктураЗаписи);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивСтруктур;
КонецФункции

