
// Выгрузка данных 1С в ClickHouse.
//
// Схема хранения: ReplacingMergeTree(_version) — только INSERT, без ALTER DELETE (CH-01/K-02).
// Каждая строка получает служебные поля:
//   _version    — одна версия на весь прогон (мс универсального времени);
//   _is_deleted — мягкое удаление (1 = надгробие).
// Атомарность «шапка + ТЧ» — порядком вставки: сначала все ТЧ, шапка последней (= коммит).
// Регистры выгружаются регистраторами целиком (K-01): список изменённых регистраторов
// собирается по движениям за окно и по аудиторскому следу документов-регистраторов (K-04).
// DDL таблиц *_v2 и представлений — в файле clickhouse/ddl-шаблоны-v2.sql репозитория.
// Подробное обоснование — docs/audit/08-руководство-по-исправлению.md.

#Область РегламентныеЗадания

&НаСервере
Процедура Выгрузка_День_Документы_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт

	Если КХ_УжеВыполняется("Выгрузка_День_Документы_ОС") Тогда
		Возврат; // A-02: защита от параллельного запуска
	КонецЕсли;

	РазмерПачки = 1000; // P-01/P-07: пачка ссылок; 5000 давало пиковую память × ширина × ТЧ

	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;

	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;

	тМассивМетаданных = КХ_ПолучитьМассивМетаданныхОтправляемыхДокументов();
	КХ_Загрузить_из_ОС(тМассивМетаданных, ПериодОт, ПериодДо, РазмерПачки);

КонецПроцедуры

&НаСервере
Процедура Выгрузка_День_Справочники_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт

	Если КХ_УжеВыполняется("Выгрузка_День_Справочники_ОС") Тогда
		Возврат; // A-02
	КонецЕсли;

	РазмерПачки = 1000;

	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;

	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;

	тМассивМетаданных = КХ_ПолучитьМассивМетаданныхОтправляемыхСправочников();
	КХ_Загрузить_из_ОС(тМассивМетаданных, ПериодОт, ПериодДо, РазмерПачки);

КонецПроцедуры

&НаСервере
Процедура Выгрузка_День_Регистры_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт

	Если КХ_УжеВыполняется("Выгрузка_День_Регистры_ОС") Тогда
		Возврат; // A-02
	КонецЕсли;

	// Для регистров РазмерПачки — это число РЕГИСТРАТОРОВ в пачке (у одного регистратора
	// может быть много строк движений), пачка формируется по регистраторам целиком (K-01)
	РазмерПачки = 300;

	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;

	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;

	тМассивМетаданных = КХ_ПолучитьМассивМетаданныхОтправляемыхРегистров();
	КХ_Загрузить_из_ОС(тМассивМетаданных, ПериодОт, ПериодДо, РазмерПачки);

КонецПроцедуры

#КонецОбласти

#Область Метаданные

&НаСервере
Функция КХ_ПолучитьМассивМетаданныхОтправляемыхДокументов()

	тМетаданные = Новый Массив;

	тМетаданные.Добавить(Метаданные.Документы.ПоступлениеНаРасчетныйСчет);
	тМетаданные.Добавить(Метаданные.Документы.ПоступлениеТоваровУслуг);
	тМетаданные.Добавить(Метаданные.Документы.ПредметДоговора);
	тМетаданные.Добавить(Метаданные.Документы.ПриходныйКассовыйОрдер);
	тМетаданные.Добавить(Метаданные.Документы.РасходныйКассовыйОрдер);
	тМетаданные.Добавить(Метаданные.Документы.РеализацияТоваровУслуг);
	тМетаданные.Добавить(Метаданные.Документы.СчетНаОплатуПокупателю);
	тМетаданные.Добавить(Метаданные.Документы.СчетНаОплатуПоставщика);
	тМетаданные.Добавить(Метаданные.Документы.СписаниеСРасчетногоСчета);

	Возврат тМетаданные;

