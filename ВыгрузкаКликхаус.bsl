Функция КХ_ПолучитьДанныеРегистровИзБазы_АУ(ТипМетаданных, РазмерПачки, ПараметрыЗапроса) 
	
	РазмерПачкиСтрокой = Сервисный.УдалитьИзСтрокиНеЦифры(Строка(РазмерПачки));
	МассивСтруктур = Новый Массив;
	
	Если Метаданные.РегистрыСведений.Содержит(ТипМетаданных) ИЛИ Метаданные.РегистрыНакопления.Содержит(ТипМетаданных) Тогда
		
		ИмяМетаданныхСтрока = ТипМетаданных.Имя;
		Если Метаданные.РегистрыСведений.Содержит(ТипМетаданных) Тогда
			ТипМетаданныхСтрока = "РегистрСведений";
		ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ТипМетаданных) Тогда
			ТипМетаданныхСтрока = "РегистрНакопления";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ * ИЗ " + ТипМетаданныхСтрока + "." + ИмяМетаданныхСтрока + " КАК " + ИмяМетаданныхСтрока + " ГДЕ " + ИмяМетаданныхСтрока + ".Период МЕЖДУ &ПериодОт И &ПериодДо";
		
		Запрос.УстановитьПараметр("ПериодОт", ПараметрыЗапроса.ПериодОт);
		Запрос.УстановитьПараметр("ПериодДо", ПараметрыЗапроса.ПериодДо);
		
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выгрузка = Результат.Выгрузить();
		Иначе
			Возврат МассивСтруктур;
		КонецЕсли;
		
		Для Каждого ТекСтрока Из Выгрузка Цикл
			СтруктураЗаписи = Новый Структура; 
			
			Для Каждого Колонка Из Выгрузка.Колонки Цикл
				ИмяКолонки = Колонка.Имя;
				ЗначениеЯчейки = ТекСтрока[ИмяКолонки];
				НазваниеПоля = КХ_ТранслитерироватьСтроку(ИмяКолонки);
				
				Если ЗначениеЗаполнено(ЗначениеЯчейки) Тогда
					ЗначениеПоля = КХ_ПреобразоватьЗначение(ЗначениеЯчейки);
				Иначе
					ЗначениеПоля = Неопределено;
				КонецЕсли;
				
				СтруктураЗаписи.Вставить(НазваниеПоля, ЗначениеПоля);
			КонецЦикла;
			
			МассивСтруктур.Добавить(СтруктураЗаписи);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивСтруктур;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПреобразоватьЧисло(тЗначение)
	СтрокаЧисла = СтрЗаменить(Строка(тЗначение), ",", ".");
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, " ", "");            
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, Символы.НПП, "");     
	Возврат СтрокаЧисла;
КонецФункции

&НаСервере
Функция КХ_СформироватьJSON(МассивСтруктур)
	СтрокаРезультат = "";
	Запись = Новый ЗаписьJSON;
	
	Для каждого Структура Из МассивСтруктур Цикл
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоОбъекта();
		Для каждого КлючЗначение Из Структура Цикл
			Запись.ЗаписатьИмяСвойства(КлючЗначение.Ключ);
			//Запись.ЗаписатьЗначение(КХ_ПреобразоватьЗначение(КлючЗначение.Значение));
			Запись.ЗаписатьЗначение(КлючЗначение.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
		СтрокаРезультат = СтрокаРезультат + Запись.Закрыть() + Символы.ПС;
	КонецЦикла;
	
	Возврат СтрокаРезультат;
КонецФункции

&НаСервере
Функция ОтправитьHTTP(Хост, Порт, Путь, СтрокаJSON) 
	
	Соединение = Новый HTTPСоединение(Хост, Порт, , , , , Неопределено);
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=UTF-8");
	
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	
	Возврат Ответ;
КонецФункции

&НаСервере
Функция КХ_ТранслитерироватьСтроку(Знач Стр) 
	
	// 1. Транслитерация кириллицы
	Транслит = Новый Соответствие;
	Транслит.Вставить("а", "a");
	Транслит.Вставить("б", "b");
	Транслит.Вставить("в", "v");
	Транслит.Вставить("г", "g");
	Транслит.Вставить("д", "d");
	Транслит.Вставить("е", "e");
	Транслит.Вставить("ё", "yo");
	Транслит.Вставить("ж", "zh");
	Транслит.Вставить("з", "z");
	Транслит.Вставить("и", "i");
	Транслит.Вставить("й", "y");
	Транслит.Вставить("к", "k");
	Транслит.Вставить("л", "l");
	Транслит.Вставить("м", "m");
	Транслит.Вставить("н", "n");
	Транслит.Вставить("о", "o");
	Транслит.Вставить("п", "p");
	Транслит.Вставить("р", "r");
	Транслит.Вставить("с", "s");
	Транслит.Вставить("т", "t");
	Транслит.Вставить("у", "u");
	Транслит.Вставить("ф", "f");
	Транслит.Вставить("х", "kh");
	Транслит.Вставить("ц", "ts");
	Транслит.Вставить("ч", "ch");
	Транслит.Вставить("ш", "sh");
	Транслит.Вставить("щ", "shch");
	Транслит.Вставить("ъ", "");
	Транслит.Вставить("ы", "y");
	Транслит.Вставить("ь", "");
	Транслит.Вставить("э", "e");
	Транслит.Вставить("ю", "yu");
	Транслит.Вставить("я", "ya");
	
	Результат = "";
	Для Индекс = 1 По СтрДлина(Стр) Цикл
		Символ = Сред(Стр, Индекс, 1);
		СимволНиз = НРег(Символ);
		
		Если Транслит.Получить(СимволНиз) <> Неопределено Тогда
			Значение = Транслит.Получить(СимволНиз);
			Если СимволНиз <> Символ И СтрДлина(Значение) > 0 Тогда
				// Приводим к виду: первая буква заглавная, остальные строчные
				Значение = ВРег(Лев(Значение, 1)) + НРег(Сред(Значение, 2));
			КонецЕсли;
			Результат = Результат + Значение;
		Иначе
			Код = КодСимвола(Символ);
			Если (Код >= 65 И Код <= 90) ИЛИ
				(Код >= 97 И Код <= 122) ИЛИ
				(Код >= 48 И Код <= 57) ИЛИ
				Символ = "_" Тогда
				Результат = Результат + Символ;
			Иначе
				Результат = Результат + "_";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// 2. Преобразование CamelCase → snake_case
	СтрокаСнэк = "";
	Длина = СтрДлина(Результат);
	Для Индекс = 1 По Длина Цикл
		ТекСимвол = Сред(Результат, Индекс, 1);
		Если Индекс = 1 Тогда
			СтрокаСнэк = ТекСимвол;
			Продолжить;
		КонецЕсли;
		
		ПредСимвол = Сред(Результат, Индекс - 1, 1);
		СледСимвол = ?(Индекс < Длина, Сред(Результат, Индекс + 1, 1), "");
		
		КодТек = КодСимвола(ТекСимвол);
		КодПред = КодСимвола(ПредСимвол);
		КодСлед = ?(Индекс < Длина, КодСимвола(СледСимвол), 0);
		
		ТекЗаглавная = (КодТек >= 65 И КодТек <= 90);
		ПредЗаглавная = (КодПред >= 65 И КодПред <= 90);
		СледСтрочная = (КодСлед >= 97 И КодСлед <= 122);
		ПредСтрочная = (КодПред >= 97 И КодПред <= 122);
		ПредЦифра = (КодПред >= 48 И КодПред <= 57);
		
		Если (ПредСтрочная ИЛИ ПредЦифра) И ТекЗаглавная Тогда
			СтрокаСнэк = СтрокаСнэк + "_" + ТекСимвол;
		ИначеЕсли ПредЗаглавная И ТекЗаглавная И СледСтрочная Тогда
			СтрокаСнэк = СтрокаСнэк + "_" + ТекСимвол;
		Иначе
			СтрокаСнэк = СтрокаСнэк + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	
	// 3. Приводим к нижнему регистру
	СтрокаСнэк = НРег(СтрокаСнэк);
	
	// 4. Убираем повторяющиеся подчёркивания
	Пока Найти(СтрокаСнэк, "__") > 0 Цикл
		СтрокаСнэк = СтрЗаменить(СтрокаСнэк, "__", "_");
	КонецЦикла;
	
	// 5. Убираем ведущие и замыкающие подчёркивания
	Если Лев(СтрокаСнэк, 1) = "_" Тогда
		СтрокаСнэк = Сред(СтрокаСнэк, 2);
	КонецЕсли;
	Если Прав(СтрокаСнэк, 1) = "_" Тогда
		СтрокаСнэк = Лев(СтрокаСнэк, СтрДлина(СтрокаСнэк) - 1);
	КонецЕсли;
	
	// 6. Если строка пуста
	Если ПустаяСтрока(СтрокаСнэк) Тогда
		СтрокаСнэк = "field";
	КонецЕсли;
	
	// 7. Если начинается с цифры
	ПервыйСимвол = Лев(СтрокаСнэк, 1);
	КодПервого = КодСимвола(ПервыйСимвол);
	Если КодПервого >= 48 И КодПервого <= 57 Тогда
		СтрокаСнэк = "n_" + СтрокаСнэк;
	КонецЕсли;
	
	Возврат СтрокаСнэк;
КонецФункции

&НаСервере
Функция КХ_ПреобразоватьЗначение(Знач тЗначение) 
	тНовоеЗначение = Неопределено;
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение))И ЗначениеЗаполнено(тЗначение) Тогда
		тНовоеЗначение = Строка(тЗначение);
	ИначеЕсли (Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение)) ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение))) И ЗначениеЗаполнено(тЗначение) Тогда
		Попытка тНовоеЗначение = ПолучитьНавигационнуюСсылку(тЗначение); Исключение тНовоеЗначение = СокрЛП(Строка(тЗначение)) КонецПопытки; // Для предопределенных
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Число") Тогда    
		//тНовоеЗначение = ПреобразоватьЧисло(тЗначение);
		тНовоеЗначение = тЗначение;
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Строка") И ЗначениеЗаполнено(тЗначение) Тогда
		тНовоеЗначение = СокрЛП(тЗначение);
		Если СтрДлина(тЗначение) = 19 И СтрЧислоВхождений(тЗначение, ":") = 2 И СтрЧислоВхождений(тЗначение, "-") = 2 Тогда // Это дата!!!
			Если Сред(тЗначение, 12) = "00:00:00" Тогда
				тНовоеЗначение = Лев(тЗначение, 10);
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Дата") И ЗначениеЗаполнено(тЗначение) Тогда
		тЗначениеДата = Дата(тЗначение);
		
		Если (Год(тЗначение) = 1 И Месяц(тЗначение) = 1 И День(тЗначение) = 1) ИЛИ ((Год(тЗначение) = 0 И Месяц(тЗначение) = 0 И День(тЗначение) = 0)) Тогда
			//тНовоеЗначение = "1970-01-01 " + СокрЛП(Формат(тЗначение, "ДФ=HH:mm:ss"));
			тНовоеЗначение = Неопределено;
		ИначеЕсли Час(тЗначение) = 0 И Минута(тЗначение) = 0 И Секунда(тЗначение) = 0 Тогда
			//тНовоеЗначение = Формат(тЗначение, "ДФ=yyyy-MM-dd") + " " + "00:00:00";
			тНовоеЗначение = Формат(тЗначение, "ДФ=yyyy-MM-dd");
		Иначе
			тНовоеЗначение = Формат(тЗначение, "ДФ=yyyy-MM-dd") + " " + Формат(тЗначение, "ДФ=HH:mm:ss");
		КонецЕсли;
		тНовоеЗначение = СтрЗаменить(тНовоеЗначение, Символ(160), " ");
		тНовоеЗначение = СокрЛП(тНовоеЗначение);
	ИначеЕсли ТипЗнч(тЗначение) = Тип("УникальныйИдентификатор") И ЗначениеЗаполнено(тЗначение) Тогда
		тНовоеЗначение = СокрЛП(тЗначение);	
	ИначеЕсли  ТипЗнч(тЗначение) = Тип("Булево") тогда
		тНовоеЗначение = тЗначение; 
	КонецЕсли;
	
	Возврат тНовоеЗначение;	
	
КонецФункции

&НаСервере
Функция РазбитьМассив(тМассив, РазмерПачки) 
	
	тИтогМассив = Новый Массив;
	тВсего = тМассив.Количество();
	
	Если тВсего < РазмерПачки Тогда
		тИтогМассив.Добавить(тМассив);
		Возврат тИтогМассив;
	КонецЕсли;
	
	Если тВсего = 0 Тогда
		Возврат тИтогМассив;
	КонецЕсли;
	
	КоличествоПачек = Цел((тВсего + РазмерПачки - 1) / РазмерПачки);
	
	Для Индекс = 0 По КоличествоПачек - 1 Цикл
		Начало = Индекс * РазмерПачки;
		Конец = Начало + РазмерПачки - 1;
		Если Конец >= тВсего Тогда
			Конец = тВсего - 1;
		КонецЕсли;
		
		тТекМассив = Новый Массив;
		Для i = Начало По Конец Цикл
			тТекМассив.Добавить(тМассив[i]);
		КонецЦикла;
		
		тИтогМассив.Добавить(тТекМассив);
	КонецЦикла;
	
	Возврат тИтогМассив;
	
КонецФункции

&НаСервере
Функция МассивСтруктурСсылокВМассивСсылок(МассивСтруктур)
