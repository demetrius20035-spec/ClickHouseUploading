#КонецОбласти

#Область ОсновнойЦиклВыгрузки

&НаСервере
Процедура КХ_Загрузить_из_ОС(МассивМетаданных, ПериодОт, ПериодДо, РазмерПачки) Экспорт

	Если МассивМетаданных.Количество() = 0 Тогда // K-11
		Возврат;
	КонецЕсли;

	// Одна версия на весь прогон: ретрай любой пачки с той же версией идемпотентен —
	// ReplacingMergeTree(_version) схлопнет дубли по ключу сортировки
	ВерсияПрогона = ТекущаяУниверсальнаяДатаВМиллисекундах();

	тПараметрыЗапроса = Новый Структура;
	тПараметрыЗапроса.Вставить("ПериодОт", ПериодОт);
	тПараметрыЗапроса.Вставить("ПериодДо", ПериодДо);

	Сообщить("================ Время начала - " + Строка(ТекущаяДатаСеанса()) + " ================ ");

	тОшибокОбъектов = 0;

	Для Каждого тМД Из МассивМетаданных Цикл
		// Сбой одного объекта не должен останавливать выгрузку остальных (K-10, CH-05)
		Попытка
			Если Метаданные.РегистрыНакопления.Содержит(тМД) Тогда
				КХ_ВыгрузитьРегистр(тМД, тПараметрыЗапроса, РазмерПачки, ВерсияПрогона);
			ИначеЕсли Метаданные.Справочники.Содержит(тМД) Тогда
				КХ_ВыгрузитьОбъектСоСсылками(тМД, "Справочник", "spravochnik_", тПараметрыЗапроса, РазмерПачки, ВерсияПрогона);
			ИначеЕсли Метаданные.Документы.Содержит(тМД) Тогда
				КХ_ВыгрузитьОбъектСоСсылками(тМД, "Документ", "dokument_", тПараметрыЗапроса, РазмерПачки, ВерсияПрогона);
			Иначе
				// N-09: неподдерживаемый тип фиксируем явно, а не игнорируем молча
				КХ_Журнал(УровеньЖурналаРегистрации.Предупреждение, Строка(тМД),
					"Тип метаданных не поддерживается выгрузкой — объект пропущен");
			КонецЕсли;
		Исключение
			тОшибокОбъектов = тОшибокОбъектов + 1;
			КХ_Журнал(УровеньЖурналаРегистрации.Ошибка, Строка(тМД),
				"Объект не выгружен (будет повторён следующим прогоном): "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Сообщить("ОШИБКА выгрузки " + Строка(тМД) + " — подробности в журнале регистрации");
		КонецПопытки;
	КонецЦикла;

	ИтогТекст = "Версия прогона " + Формат(ВерсияПрогона, "ЧГ=0")
		+ "; объектов: " + Строка(МассивМетаданных.Количество())
		+ "; с ошибками: " + Строка(тОшибокОбъектов);
	УровеньИтога = ?(тОшибокОбъектов = 0, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Ошибка);
	КХ_Журнал(УровеньИтога, "Итог прогона", ИтогТекст);

	Сообщить(ИтогТекст);
	Сообщить("================ Время окончания - " + Строка(ТекущаяДатаСеанса()) + " ================ ");

КонецПроцедуры

// Выгрузка справочника или документа: пачками ссылок, внутри пачки сначала ВСЕ табличные
// части, шапка — последней. Шапка играет роль коммита: пока она не записана, строки ТЧ
// новой версии невидимы для представлений (они читают ТЧ по max(_version) шапки), поэтому
// сбой на любом шаге не оставляет ни дыр, ни половинчатых документов (K-02, K-03).
&НаСервере
Процедура КХ_ВыгрузитьОбъектСоСсылками(тМД, ТипСтрока, Префикс, ПараметрыЗапроса, РазмерПачки, ВерсияПрогона)

	ИмяОбъекта = КХ_ТранслитерироватьСтроку(тМД.Имя);
	ИмяОсновнойТаблицы = КХ_ИмяТаблицы(Префикс + ИмяОбъекта);

	ПолныйМассивСтруктурСсылок = КХ_ПолучитьСсылкиИзБазы_АУ(тМД, ТипСтрока, ПараметрыЗапроса);
	Если ПолныйМассивСтруктурСсылок.Количество() = 0 Тогда
		Сообщить(Строка(тМД) + " - изменений нет");
		Возврат;
	КонецЕсли;

	тСчетчик = 0;
	МассивПачек = РазбитьМассив(ПолныйМассивСтруктурСсылок, РазмерПачки);

	Для Каждого тМассив Из МассивПачек Цикл

		МассивСсылок = МассивСтруктурСсылокВМассивСсылок(тМассив);

		ПолныйМассивДанных = КХ_ПолучитьДанныеОбъектов(МассивСсылок, тМД, ТипСтрока);

		// 1. Все табличные части. Исключение при вставке любой ТЧ прервёт объект ДО вставки
		//    шапки — читатели продолжат видеть предыдущую целостную версию, а следующий
		//    прогон перевыгрузит объект заново (идемпотентно).
		Для Каждого ТЧ Из тМД.ТабличныеЧасти Цикл
			ПолныйМассивДанныхТЧ = КХ_ПолучитьДанныеТЧИзБазы(МассивСсылок, тМД, ТипСтрока, ТЧ);
			Если ПолныйМассивДанныхТЧ.Количество() = 0 Тогда // CH-08: пустую ТЧ не отправляем
				Продолжить;
			КонецЕсли;
			ИмяТаблицыТЧ = КХ_ИмяТаблицы(Префикс + ИмяОбъекта + "_" + КХ_ТранслитерироватьСтроку(ТЧ.Имя));
			КХ_ОтправитьДанные(КХ_СформироватьJSON(ПолныйМассивДанныхТЧ, ВерсияПрогона), ИмяТаблицыТЧ);
		КонецЦикла;

		// 2. Шапка — коммит пачки
		КХ_ОтправитьДанные(КХ_СформироватьJSON(ПолныйМассивДанных, ВерсияПрогона), ИмяОсновнойТаблицы);

		тСчетчик = тСчетчик + ПолныйМассивДанных.Количество();

	КонецЦикла;

	Сообщить(Строка(тМД) + " - загружено - " + Строка(тСчетчик));

КонецПроцедуры

// Выгрузка регистра накопления: единица работы — регистратор ЦЕЛИКОМ (K-01).
// Список изменённых регистраторов = движения за окно + аудиторский след
// документов-регистраторов (ловит перепроведения и распроведения — K-04).
// Строки выбираются БЕЗ фильтра по периоду, пачки формируются по регистраторам,
// регистратор никогда не режется границей пачки. Регистратору без движений
// вставляется надгробие (_is_deleted = 1), иначе представление вечно показывало бы
// его старую версию — max(_version) без новой вставки не сдвинется.
&НаСервере
Процедура КХ_ВыгрузитьРегистр(тРегистрМД, ПараметрыЗапроса, РазмерПачкиРегистраторов, ВерсияПрогона)

	ИмяТаблицы = КХ_ИмяТаблицы("registr_nakopleniya_" + КХ_ТранслитерироватьСтроку(тРегистрМД.Имя));

	Регистраторы = КХ_ПолучитьИзмененныеРегистраторы(тРегистрМД, ПараметрыЗапроса);
	Если Регистраторы.Количество() = 0 Тогда
		Сообщить(Строка(тРегистрМД) + " - изменений нет");
		Возврат;
	КонецЕсли;

	тСчетчик = 0;
	МассивПачек = РазбитьМассив(Регистраторы, РазмерПачкиРегистраторов); // P-01: пагинация на уровне запроса

	Для Каждого ПачкаРегистраторов Из МассивПачек Цикл

		МассивСтрок = КХ_ПолучитьДвиженияРегистраторов(тРегистрМД, ПачкаРегистраторов);

		// Надгробия для распроведённых регистраторов пачки
		Присутствуют = Новый Соответствие;
		Для Каждого тСтрока Из МассивСтрок Цикл
			Присутствуют.Вставить(тСтрока["registrator"], Истина);
		КонецЦикла;

		Для Каждого Регистратор Из ПачкаРегистраторов Цикл
			НавСсылка = КХ_ПреобразоватьЗначение(Регистратор);
			Если Присутствуют.Получить(НавСсылка) = Неопределено Тогда
				Надгробие = Новый Структура;
				Надгробие.Вставить("registrator", НавСсылка);
				Надгробие.Вставить("nomer_stroki", 0);
				Надгробие.Вставить("_is_deleted", 1);
				// Остальные колонки заполнятся значениями по умолчанию:
				// input_format_defaults_for_omitted_fields в ClickHouse включён по умолчанию
				МассивСтрок.Добавить(Надгробие);
			КонецЕсли;
		КонецЦикла;

		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Регистратор целиком в одном INSERT; ретрай с той же версией схлопнется движком
		КХ_ОтправитьДанные(КХ_СформироватьJSON(МассивСтрок, ВерсияПрогона), ИмяТаблицы);
		тСчетчик = тСчетчик + МассивСтрок.Количество();

	КонецЦикла;

	Сообщить(Строка(тРегистрМД) + " - загружено строк - " + Строка(тСчетчик)
		+ " (регистраторов: " + Строка(Регистраторы.Количество()) + ")");

КонецПроцедуры

#КонецОбласти

#Область ПолучениеДанных

// Изменённые регистраторы регистра за окно: по периоду движений и по аудиторскому следу
// каждого типа документа-регистратора. Вторая часть ловит регистраторы, чьи движения
// ушли из окна (перепроведение задним числом) или исчезли совсем (распроведение).
&НаСервере
Функция КХ_ПолучитьИзмененныеРегистраторы(тРегистрМД, ПараметрыЗапроса)

	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Т.Регистратор КАК Регистратор"
		+ " ИЗ РегистрНакопления." + тРегистрМД.Имя + " КАК Т"
		+ " ГДЕ Т.Период МЕЖДУ &ПериодОт И &ПериодДо");

	Для Каждого ДокМД Из тРегистрМД.Регистраторы Цикл
		ЧастиЗапроса.Добавить(
			"ВЫБРАТЬ РАЗЛИЧНЫЕ ВЫРАЗИТЬ(АС.Объект КАК Документ." + ДокМД.Имя + ")"
			+ " ИЗ Справочник.АудиторскийСлед КАК АС"
			+ " ГДЕ АС.Дата МЕЖДУ &ПериодОт И &ПериодДо"
			+ " И АС.Объект ССЫЛКА Документ." + ДокМД.Имя);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, " ОБЪЕДИНИТЬ ");
	Запрос.УстановитьПараметр("ПериодОт", ПараметрыЗапроса.ПериодОт);
	Запрос.УстановитьПараметр("ПериодДо", ПараметрыЗапроса.ПериодДо);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");

КонецФункции

// Все текущие движения регистраторов пачки — БЕЗ фильтра по периоду:
// предикат выборки совпадает с единицей замещения версии (регистратор целиком)
&НаСервере
Функция КХ_ПолучитьДвиженияРегистраторов(тРегистрМД, ПачкаРегистраторов)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ РегистрНакопления." + тРегистрМД.Имя + " КАК Т"
		+ " ГДЕ Т.Регистратор В (&Регистраторы)";
	Запрос.УстановитьПараметр("Регистраторы", ПачкаРегистраторов);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат КХ_ВыгрузкаВМассивСтруктур(Результат.Выгрузить(), Ложь);

КонецФункции

// Ссылки изменённых объектов: аудиторский след + (если реквизит есть) ДатаСоздания.
// K-10: отсутствие реквизита «ДатаСоздания» больше не роняет запрос — ветка добавляется
// только при его наличии в метаданных.
&НаСервере
Функция КХ_ПолучитьСсылкиИзБазы_АУ(тМД, ТипСтрока, ПараметрыЗапроса)

	ИмяМД = тМД.Имя;
	ЕстьДатаСоздания = (тМД.Реквизиты.Найти("ДатаСоздания") <> Неопределено);

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	АудиторскийСлед.Объект КАК Ссылка
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Справочник.АудиторскийСлед КАК АудиторскийСлед
	|ГДЕ
	|	АудиторскийСлед.Дата МЕЖДУ &ДатаПериодаОт И &ДатаПериодаДо
	|	И АудиторскийСлед.Объект ССЫЛКА " + ТипСтрока + "." + ИмяМД + "
	|	И АудиторскийСлед.Объект.Ссылка ЕСТЬ НЕ NULL
	|СГРУППИРОВАТЬ ПО
	|	АудиторскийСлед.Объект";

	Если ЕстьДатаСоздания Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Ссылка
		|ИЗ
		|	" + ТипСтрока + "." + ИмяМД + " КАК Т
		|ГДЕ
		|	Т.ДатаСоздания ЕСТЬ НЕ NULL
		|	И Т.ДатаСоздания МЕЖДУ &ДатаСозданияОт И &ДатаСозданияДо";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВременнаяТаблица.Ссылка КАК Ссылка
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|СГРУППИРОВАТЬ ПО
	|	ВременнаяТаблица.Ссылка";

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДатаПериодаОт", ПараметрыЗапроса.ПериодОт);
	Запрос.УстановитьПараметр("ДатаПериодаДо", ПараметрыЗапроса.ПериодДо);
	Запрос.УстановитьПараметр("ДатаСозданияОт", ПараметрыЗапроса.ПериодОт);
	Запрос.УстановитьПараметр("ДатаСозданияДо", ПараметрыЗапроса.ПериодДо);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат КХ_ВыгрузкаВМассивСтруктур(Результат.Выгрузить(), Ложь);

КонецФункции

&НаСервере
Функция КХ_ПолучитьДанныеОбъектов(МассивСсылок, тМД, ТипСтрока)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ " + ТипСтрока + "." + тМД.Имя + " КАК Т"
		+ " ГДЕ Т.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	// Истина = пропускать колонки-таблицы значений: табличные части выгружаются отдельно
	Возврат КХ_ВыгрузкаВМассивСтруктур(Результат.Выгрузить(), Истина);

КонецФункции

&НаСервере
Функция КХ_ПолучитьДанныеТЧИзБазы(МассивСсылок, тМД, ТипСтрока, ТЧ)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ " + ТипСтрока + "." + тМД.Имя + "." + Строка(ТЧ.Имя) + " КАК Т"
		+ " ГДЕ Т.Ссылка В (&МассивСсылок)";
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат КХ_ВыгрузкаВМассивСтруктур(Результат.Выгрузить(), Ложь);

КонецФункции

// Единый конвертер «выгрузка запроса → массив структур» (A-03: одна реализация вместо четырёх).
// P-03: имена колонок транслитерируются один раз на выборку, а не на каждую ячейку.
&НаСервере
Функция КХ_ВыгрузкаВМассивСтруктур(Выгрузка, ПропускатьВложенныеТаблицы)

	МассивСтруктур = Новый Массив;

	ОписаниеТипаТЧ = Новый ОписаниеТипов("ТаблицаЗначений");
	КолонкиПоля = Новый Массив;
	Для Каждого Колонка Из Выгрузка.Колонки Цикл
		Если ПропускатьВложенныеТаблицы И Колонка.ТипЗначения = ОписаниеТипаТЧ Тогда
			Продолжить;
		КонецЕсли;
		Пара = Новый Структура("Имя, Поле", Колонка.Имя, КХ_ТранслитерироватьСтроку(Колонка.Имя));
		КолонкиПоля.Добавить(Пара);
	КонецЦикла;

	Для Каждого ТекСтрока Из Выгрузка Цикл
		СтруктураЗаписи = Новый Структура;
		Для Каждого Пара Из КолонкиПоля Цикл
			ЗначениеЯчейки = ТекСтрока[Пара.Имя];
			Если ЗначениеЯчейки = Неопределено Тогда
				СтруктураЗаписи.Вставить(Пара.Поле, Неопределено);
			Иначе
				СтруктураЗаписи.Вставить(Пара.Поле, КХ_ПреобразоватьЗначение(ЗначениеЯчейки));
			КонецЕсли;
		КонецЦикла;
		МассивСтруктур.Добавить(СтруктураЗаписи);
	КонецЦикла;

	Возврат МассивСтруктур;

КонецФункции

#КонецОбласти

#Область ВзаимодействиеСClickHouse

// INSERT пачки в формате JSONEachRow. Пустое тело не отправляется (CH-08).
// input_format_null_as_default=1 — случайный null в не-Nullable колонке не валит пачку (CH-07).
// Ретраи INSERT безопасны: та же _version схлопывается движком ReplacingMergeTree.
&НаСервере
Функция КХ_ОтправитьДанные(СтрокаJSON, ИмяТаблицы)

	Если ПустаяСтрока(СтрокаJSON) Тогда
		Возврат 200;
	КонецЕсли;

	ДанныеАвторизации = КХ_ПолучитьДанныеАвторизации();
	ДанныеХостПорт = КХ_ПолучитьХостПорт();

	ЗапросSQL = "INSERT INTO " + ИмяТаблицы + " FORMAT JSONEachRow";

	Путь = "/?query=" + КХ_ЗакодироватьURL(ЗапросSQL)
		+ "&input_format_null_as_default=1"
		+ "&user=" + ДанныеАвторизации.Пользователь
		+ "&password=" + ДанныеАвторизации.Пароль;

	Ответ = ОтправитьHTTP(ДанныеХостПорт.Host, ДанныеХостПорт.Port, Путь, СтрокаJSON, 3,
		"INSERT " + ИмяТаблицы);

	Возврат Ответ.КодСостояния;

КонецФункции

// Служебное удаление по списку значений. В основном цикле выгрузки НЕ используется
// (схема без мутаций); нужно для первичной чистки и ручных операций.
// N-03: список дедуплицируется. Мутации не ретраятся (МаксПопыток = 1): повтор мог бы
// поставить в очередь вторую такую же мутацию при потерянном ответе первой.
&НаСервере
Функция КХ_УдалитьДанныеПоСписку(МассивЗначений, ИмяТаблицы, ПолеОтбора) Экспорт

	Уникальные = Новый Соответствие;
	СписокЗначений = Новый Массив;
	Для Каждого тЗначение Из МассивЗначений Цикл
		Если НЕ ЗначениеЗаполнено(тЗначение) Тогда
			Продолжить;
		КонецЕсли;
		тСтроковое = Строка(тЗначение);
		Если Уникальные.Получить(тСтроковое) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уникальные.Вставить(тСтроковое, Истина);
		СписокЗначений.Добавить("'" + СтрЗаменить(тСтроковое, "'", "''") + "'");
	КонецЦикла;

	Если СписокЗначений.Количество() = 0 Тогда
		Возврат 200;
	КонецЕсли;

	ДанныеАвторизации = КХ_ПолучитьДанныеАвторизации();
	ДанныеХостПорт = КХ_ПолучитьХостПорт();

	// CH-03: max_execution_time ограничен и меньше HTTP-таймаута, чтобы ошибка приходила
	// от ClickHouse с текстом, а не обрывом соединения
	ЗапросSQL = "ALTER TABLE " + ИмяТаблицы
		+ " DELETE WHERE " + ПолеОтбора + " IN (" + СтрСоединить(СписокЗначений, ", ") + ")"
		+ " SETTINGS mutations_sync = 2, max_execution_time = 240";

	Путь = "/?user=" + ДанныеАвторизации.Пользователь + "&password=" + ДанныеАвторизации.Пароль;

	Ответ = ОтправитьHTTP(ДанныеХостПорт.Host, ДанныеХостПорт.Port, Путь, ЗапросSQL, 1,
		"ALTER DELETE " + ИмяТаблицы);

	Возврат Ответ.КодСостояния;

КонецФункции

// Плановая зачистка фантомов регистра: удаляет строки всех версий регистратора, кроме
// максимальной. Единственная мутация в схеме — запускать редко (раз в сутки/неделю),
// отдельным регламентным заданием в окно низкой нагрузки. mutations_sync = 0: мутация
// ставится в очередь и выполняется фоном, ответ не ждём.
&НаСервере
Функция КХ_ЗачиститьФантомыРегистра(ИмяТаблицы) Экспорт

	ДанныеАвторизации = КХ_ПолучитьДанныеАвторизации();
	ДанныеХостПорт = КХ_ПолучитьХостПорт();

	// Оконные функции в HAVING в ClickHouse запрещены (допустимы только в SELECT/ORDER BY),
	// поэтому «не максимальная версия регистратора» выражается через NOT IN по парам
	// (registrator, max(_version)). Подзапрос вычисляется один раз в момент постановки
	// мутации; куски, вставленные позже, мутация не трогает — свежие версии не пострадают,
	// худший случай — фантом доживёт до следующей зачистки.
	ЗапросSQL = "ALTER TABLE " + ИмяТаблицы
		+ " DELETE WHERE (registrator, _version) NOT IN ("
		+ "SELECT registrator, max(_version) FROM " + ИмяТаблицы
		+ " GROUP BY registrator)"
		+ " SETTINGS mutations_sync = 0";

	Путь = "/?user=" + ДанныеАвторизации.Пользователь + "&password=" + ДанныеАвторизации.Пароль;

	Ответ = ОтправитьHTTP(ДанныеХостПорт.Host, ДанныеХостПорт.Port, Путь, ЗапросSQL, 1,
		"ЗАЧИСТКА " + ИмяТаблицы);

	Возврат Ответ.КодСостояния;

КонецФункции

// HTTP-запрос к ClickHouse с ретраями и журналированием.
// CH-03: таймаут ПЕРЕДАЁТСЯ в конструктор (6-й параметр) — зависаний навсегда больше нет.
// Пауза между попытками экспоненциальная: 5, 10, 20 c (при TOO_MANY_PARTS частые
// повторы бессмысленны). Каждая неудачная попытка пишется в журнал регистрации с
// усечённым телом ответа ClickHouse — главной диагностикой (A-06).
// После исчерпания попыток — исключение; вызывающий цикл перехватывает его на уровне
// объекта метаданных. Путь запроса в журнал не пишется (содержит пароль).
&НаСервере
Функция ОтправитьHTTP(Хост, Порт, Путь, ТелоЗапроса, Знач МаксПопыток = 3, Знач Контекст = "")

	Таймаут = 300;
	ЗадержкаСекунд = 5;

	Для НомерПопытки = 1 По МаксПопыток Цикл

		ОписаниеОшибки = "";

		Попытка
			Соединение = Новый HTTPСоединение(Хост, Порт, , , , Таймаут, Неопределено);

			Заголовки = Новый Соответствие;
			Заголовки.Вставить("Content-Type", "application/json; charset=UTF-8");

			Запрос = Новый HTTPЗапрос(Путь, Заголовки);
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);

			Ответ = Соединение.ОтправитьДляОбработки(Запрос);

			Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
				Возврат Ответ;
			КонецЕсли;

			ОписаниеОшибки = "HTTP " + Строка(Ответ.КодСостояния) + ": "
				+ Лев(Ответ.ПолучитьТелоКакСтроку(), 1000);
		Исключение
			ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;

		// Промежуточные неудачи — Предупреждение (ретрай может самовосстановиться),
		// финальная — Ошибка: мониторинг по уровню «Ошибка» не шумит на переживших ретрай
		УровеньЗаписи = ?(НомерПопытки = МаксПопыток,
			УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Предупреждение);
		КХ_Журнал(УровеньЗаписи,
			Контекст + " (попытка " + Строка(НомерПопытки) + " из " + Строка(МаксПопыток) + ", хост " + Хост + ")",
			ОписаниеОшибки);

		Если НомерПопытки = МаксПопыток Тогда
			ВызватьИсключение "ClickHouse: не удалось выполнить запрос [" + Контекст + "] после "
				+ Строка(МаксПопыток) + " попыток. Последняя ошибка: " + ОписаниеОшибки;
		КонецЕсли;

		Сервисный.Задержка(ЗадержкаСекунд);
		ЗадержкаСекунд = ЗадержкаСекунд * 2;

	КонецЦикла;

	// Недостижимо (последняя итерация всегда возвращает ответ или бросает исключение)
	ВызватьИсключение "ClickHouse: не удалось выполнить запрос [" + Контекст + "]";

КонецФункции

&НаСервере
Функция КХ_ЗакодироватьURL(Знач СтрокаДляКодирования)
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "%", "%25");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, " ", "%20");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "!", "%21");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "#", "%23");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "$", "%24");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "&", "%26");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "'", "%27");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "(", "%28");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ")", "%29");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "*", "%2A");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "+", "%2B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ",", "%2C");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "/", "%2F");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ":", "%3A");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, ";", "%3B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "=", "%3D");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "?", "%3F");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "@", "%40");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "[", "%5B");
	СтрокаДляКодирования = СтрЗаменить(СтрокаДляКодирования, "]", "%5D");
	Возврат СтрокаДляКодирования;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сборка JSONEachRow. P-04: строки собираются в массив и соединяются один раз.
// К каждой строке дописываются служебные поля _version и (если ещё нет) _is_deleted = 0.
&НаСервере
Функция КХ_СформироватьJSON(МассивСтруктур, ВерсияПрогона)

	МассивСтрокJSON = Новый Массив;
	Запись = Новый ЗаписьJSON;

	Для Каждого Структура Из МассивСтруктур Цикл
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоОбъекта();

		ЕстьПризнакУдаления = Ложь;
		Для Каждого КлючЗначение Из Структура Цикл
			Если КлючЗначение.Ключ = "_is_deleted" Тогда
				ЕстьПризнакУдаления = Истина;
			КонецЕсли;
			Запись.ЗаписатьИмяСвойства(КлючЗначение.Ключ);
			Запись.ЗаписатьЗначение(КлючЗначение.Значение);
		КонецЦикла;

		Запись.ЗаписатьИмяСвойства("_version");
		Запись.ЗаписатьЗначение(ВерсияПрогона);
		Если НЕ ЕстьПризнакУдаления Тогда
			Запись.ЗаписатьИмяСвойства("_is_deleted");
			Запись.ЗаписатьЗначение(0);
		КонецЕсли;

		Запись.ЗаписатьКонецОбъекта();
		МассивСтрокJSON.Добавить(Запись.Закрыть());
	КонецЦикла;

	Если МассивСтрокJSON.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрСоединить(МассивСтрокJSON, Символы.ПС) + Символы.ПС;

КонецФункции

// A-02: признак параллельного запуска той же регламентной процедуры.
// При запуске регламентным заданием текущий прогон сам присутствует в списке активных,
// поэтому порог — больше одного задания с этим методом. Это закрывает главный сценарий
// A-02: новый запуск по расписанию поверх зависшего/долгого предыдущего.
// Ограничение: запуск из интерактивного сеанса при одном активном фоновом прогоне
// не блокируется — интерактивный сеанс в списке фоновых заданий отсутствует,
// и надёжно отличить его от фонового без дополнительного признака нельзя.
&НаСервере
Функция КХ_УжеВыполняется(ИмяПроцедуры)

	Отбор = Новый Структура("Состояние", СостояниеФоновогоЗадания.Активно);
	АктивныеЗадания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);

	ИскомоеИмя = ВРег("ВыгрузкаКликхаус." + ИмяПроцедуры);
	Счетчик = 0;
	Для Каждого Задание Из АктивныеЗадания Цикл
		Если СтрНайти(ВРег(Задание.ИмяМетода), ИскомоеИмя) > 0 Тогда
			Счетчик = Счетчик + 1;
		КонецЕсли;
	КонецЦикла;

	Если Счетчик > 1 Тогда
		КХ_Журнал(УровеньЖурналаРегистрации.Предупреждение, ИмяПроцедуры,
			"Выгрузка уже выполняется параллельным заданием — текущий запуск завершён без работы");
		Сообщить("Выгрузка уже выполняется — выходим");
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// A-06: единая точка журналирования (Сообщить в фоновом задании никто не видит)
&НаСервере
Процедура КХ_Журнал(Уровень, Данные, Комментарий)

	ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(
		"ОбщийМодуль.ВыгрузкаКликхаус", Уровень, , Данные, Комментарий);

КонецПроцедуры

&НаСервере
Функция КХ_ТранслитерироватьСтроку(Знач Стр)

	// 1. Транслитерация кириллицы
	Транслит = Новый Соответствие;
	Транслит.Вставить("а", "a");
	Транслит.Вставить("б", "b");
	Транслит.Вставить("в", "v");
	Транслит.Вставить("г", "g");
	Транслит.Вставить("д", "d");
	Транслит.Вставить("е", "e");
	Транслит.Вставить("ё", "yo");
	Транслит.Вставить("ж", "zh");
	Транслит.Вставить("з", "z");
	Транслит.Вставить("и", "i");
	Транслит.Вставить("й", "y");
	Транслит.Вставить("к", "k");
	Транслит.Вставить("л", "l");
	Транслит.Вставить("м", "m");
	Транслит.Вставить("н", "n");
	Транслит.Вставить("о", "o");
	Транслит.Вставить("п", "p");
	Транслит.Вставить("р", "r");
	Транслит.Вставить("с", "s");
	Транслит.Вставить("т", "t");
	Транслит.Вставить("у", "u");
	Транслит.Вставить("ф", "f");
	Транслит.Вставить("х", "kh");
	Транслит.Вставить("ц", "ts");
	Транслит.Вставить("ч", "ch");
	Транслит.Вставить("ш", "sh");
	Транслит.Вставить("щ", "shch");
	Транслит.Вставить("ъ", "");
	Транслит.Вставить("ы", "y");
	Транслит.Вставить("ь", "");
	Транслит.Вставить("э", "e");
	Транслит.Вставить("ю", "yu");
	Транслит.Вставить("я", "ya");

	Результат = "";
	Для Индекс = 1 По СтрДлина(Стр) Цикл
		Символ = Сред(Стр, Индекс, 1);
		СимволНиз = НРег(Символ);

		Если Транслит.Получить(СимволНиз) <> Неопределено Тогда
			Значение = Транслит.Получить(СимволНиз);
			Если СимволНиз <> Символ И СтрДлина(Значение) > 0 Тогда
				// Приводим к виду: первая буква заглавная, остальные строчные
				Значение = ВРег(Лев(Значение, 1)) + НРег(Сред(Значение, 2));
			КонецЕсли;
			Результат = Результат + Значение;
		Иначе
			Код = КодСимвола(Символ);
			Если (Код >= 65 И Код <= 90) ИЛИ
				(Код >= 97 И Код <= 122) ИЛИ
				(Код >= 48 И Код <= 57) ИЛИ
				Символ = "_" Тогда
				Результат = Результат + Символ;
			Иначе
				Результат = Результат + "_";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// 2. Преобразование CamelCase → snake_case
	СтрокаСнэк = "";
	Длина = СтрДлина(Результат);
	Для Индекс = 1 По Длина Цикл
		ТекСимвол = Сред(Результат, Индекс, 1);
		Если Индекс = 1 Тогда
			СтрокаСнэк = ТекСимвол;
			Продолжить;
		КонецЕсли;

		ПредСимвол = Сред(Результат, Индекс - 1, 1);
		СледСимвол = ?(Индекс < Длина, Сред(Результат, Индекс + 1, 1), "");

		КодТек = КодСимвола(ТекСимвол);
		КодПред = КодСимвола(ПредСимвол);
		КодСлед = ?(Индекс < Длина, КодСимвола(СледСимвол), 0);

		ТекЗаглавная = (КодТек >= 65 И КодТек <= 90);
		ПредЗаглавная = (КодПред >= 65 И КодПред <= 90);
		СледСтрочная = (КодСлед >= 97 И КодСлед <= 122);
		ПредСтрочная = (КодПред >= 97 И КодПред <= 122);
		ПредЦифра = (КодПред >= 48 И КодПред <= 57);

		Если (ПредСтрочная ИЛИ ПредЦифра) И ТекЗаглавная Тогда
			СтрокаСнэк = СтрокаСнэк + "_" + ТекСимвол;
		ИначеЕсли ПредЗаглавная И ТекЗаглавная И СледСтрочная Тогда
			СтрокаСнэк = СтрокаСнэк + "_" + ТекСимвол;
		Иначе
			СтрокаСнэк = СтрокаСнэк + ТекСимвол;
		КонецЕсли;
	КонецЦикла;

	// 3. Приводим к нижнему регистру
	СтрокаСнэк = НРег(СтрокаСнэк);

	// 4. Убираем повторяющиеся подчёркивания
	Пока Найти(СтрокаСнэк, "__") > 0 Цикл
		СтрокаСнэк = СтрЗаменить(СтрокаСнэк, "__", "_");
	КонецЦикла;

	// 5. Убираем ведущие и замыкающие подчёркивания
	Если Лев(СтрокаСнэк, 1) = "_" Тогда
		СтрокаСнэк = Сред(СтрокаСнэк, 2);
	КонецЕсли;
	Если Прав(СтрокаСнэк, 1) = "_" Тогда
		СтрокаСнэк = Лев(СтрокаСнэк, СтрДлина(СтрокаСнэк) - 1);
	КонецЕсли;

	// 6. Если строка пуста
	Если ПустаяСтрока(СтрокаСнэк) Тогда
		СтрокаСнэк = "field";
	КонецЕсли;

	// 7. Если начинается с цифры
	ПервыйСимвол = Лев(СтрокаСнэк, 1);
	КодПервого = КодСимвола(ПервыйСимвол);
	Если КодПервого >= 48 И КодПервого <= 57 Тогда
		СтрокаСнэк = "n_" + СтрокаСнэк;
	КонецЕсли;

	Возврат СтрокаСнэк;
КонецФункции

&НаСервере
Функция КХ_ПреобразоватьЗначение(Знач тЗначение)

	тНовоеЗначение = Неопределено;

	Если тЗначение = NULL Тогда
		// K-07: значения NULL из запроса (поля через точку от битых ссылок) — явный null
		тНовоеЗначение = Неопределено;
	ИначеЕсли ТипЗнч(тЗначение) = Тип("ВидДвиженияНакопления") И тЗначение = ВидДвиженияНакопления.Приход Тогда
		тНовоеЗначение = 0;
	ИначеЕсли ТипЗнч(тЗначение) = Тип("ВидДвиженияНакопления") И тЗначение = ВидДвиженияНакопления.Расход Тогда
		тНовоеЗначение = 1;
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение)) Тогда
		тНовоеЗначение = Строка(тЗначение);
	ИначеЕсли (Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение)) ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(тЗначение))) Тогда
		Попытка тНовоеЗначение = ПолучитьНавигационнуюСсылку(тЗначение); Исключение тНовоеЗначение = СокрЛП(Строка(тЗначение)) КонецПопытки; // Для предопределенных
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Число") Тогда
		тНовоеЗначение = тЗначение;
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Строка") Тогда
		// K-07: пустая строка остаётся пустой строкой, а не превращается в null
		тНовоеЗначение = СокрЛП(тЗначение);
		Если СтрДлина(тЗначение) = 19 И СтрЧислоВхождений(тЗначение, ":") = 2 И СтрЧислоВхождений(тЗначение, "-") = 2 Тогда // Это дата!!!
			Если Сред(тЗначение, 12) = "00:00:00" Тогда
				тНовоеЗначение = Лев(тЗначение, 10);
			КонецЕсли;
		КонецЕсли;

	ИначеЕсли ТипЗнч(тЗначение) = Тип("Дата") Тогда

		Если (Год(тЗначение) = 1 И Месяц(тЗначение) = 1 И День(тЗначение) = 1) ИЛИ ((Год(тЗначение) = 0 И Месяц(тЗначение) = 0 И День(тЗначение) = 0)) Тогда
			тНовоеЗначение = Неопределено; // пустая дата → null
		ИначеЕсли Час(тЗначение) = 0 И Минута(тЗначение) = 0 И Секунда(тЗначение) = 0 Тогда
			тНовоеЗначение = Формат(тЗначение, "ДФ=yyyy-MM-dd");
		Иначе
			тНовоеЗначение = Формат(тЗначение, "ДФ=yyyy-MM-dd") + " " + Формат(тЗначение, "ДФ=HH:mm:ss");
		КонецЕсли;
		Если тНовоеЗначение <> Неопределено Тогда
			тНовоеЗначение = СтрЗаменить(тНовоеЗначение, Символ(160), " ");
			тНовоеЗначение = СокрЛП(тНовоеЗначение);
		КонецЕсли;
	ИначеЕсли ТипЗнч(тЗначение) = Тип("УникальныйИдентификатор") И ЗначениеЗаполнено(тЗначение) Тогда
		// Нулевой UUID намеренно уходит как null
		тНовоеЗначение = СокрЛП(Строка(тЗначение));
	ИначеЕсли ТипЗнч(тЗначение) = Тип("Булево") Тогда
		тНовоеЗначение = тЗначение;
	КонецЕсли;

	Возврат тНовоеЗначение;

КонецФункции

&НаСервере
Функция РазбитьМассив(тМассив, РазмерПачки)

	тИтогМассив = Новый Массив;
	тВсего = тМассив.Количество();

	Если тВсего = 0 Тогда // K-12: пустой массив — пустой результат, а не [[]]
		Возврат тИтогМассив;
	КонецЕсли;

	Если тВсего <= РазмерПачки Тогда
		тИтогМассив.Добавить(тМассив);
		Возврат тИтогМассив;
	КонецЕсли;

	КоличествоПачек = Цел((тВсего + РазмерПачки - 1) / РазмерПачки);

	Для Индекс = 0 По КоличествоПачек - 1 Цикл
		Начало = Индекс * РазмерПачки;
		Конец = Начало + РазмерПачки - 1;
		Если Конец >= тВсего Тогда
			Конец = тВсего - 1;
		КонецЕсли;

		тТекМассив = Новый Массив;
		Для i = Начало По Конец Цикл
			тТекМассив.Добавить(тМассив[i]);
		КонецЦикла;

		тИтогМассив.Добавить(тТекМассив);
	КонецЦикла;

	Возврат тИтогМассив;

КонецФункции

