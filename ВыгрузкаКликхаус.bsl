							УровеньЖурналаРегистрации.Ошибка,,"КодСостоянияОтветаУдалениеТЧ = " + Строка(КодСостоянияОтветаУдалениеТЧ), "Новые данные не загружены в таблицу - " + ИмяТаблицыТЧ);
							//Продолжить;
						КонецЕсли;
					КонецЦикла;
				Иначе
					тОшибокУдаленияДокументов = тОшибокУдаленияДокументов + 1;
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("ОбщийМодуль.ВыгрузкаКликхаус.КХ_УдалитьДанные()",
					УровеньЖурналаРегистрации.Ошибка,,"КодСостоянияОтветаУдаление = " + Строка(КодСостоянияОтветаУдаление), "Новые данные не загружены в таблицу - " + ИмяОсновнойТаблицы);
					//Продолжить;
				КонецЕсли;
			КонецЦикла;
			Сообщить(Строка(тДокументМД) + " - загружено - " + Строка(тСчетчик));
		КонецЦикла;
		#КонецОбласти
		
	КонецЕсли;
	
	Сообщить("тОшибокУдаленияДокументов = " + Строка(тОшибокУдаленияДокументов));
	Сообщить("тОшибокУдаленияСправочников = " + Строка(тОшибокУдаленияСправочников));
	Сообщить("тОшибокУдаленияРегистров = " + Строка(тОшибокУдаленияРегистров));
	Сообщить("тОшибокУдаленияТабЧастейДокументов = " + Строка(тОшибокУдаленияТабЧастейДокументов));
	Сообщить("тОшибокУдаленияТабЧастейСправочников = " + Строка(тОшибокУдаленияТабЧастейСправочников));
	
	Сообщить("тОшибокЗаписиДокументов = " + Строка(тОшибокЗаписиДокументов));
	Сообщить("тОшибокЗаписиСправочников = " + Строка(тОшибокЗаписиСправочников));
	Сообщить("тОшибокЗаписиРегистров = " + Строка(тОшибокЗаписиРегистров));
	
