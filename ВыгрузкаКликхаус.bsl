#КонецОбласти

&НаСервере
Процедура КХ_Загрузить_из_ОС(МассивМетаданных, ПериодОт, ПериодДо, РазмерПачки) Экспорт 
	
	тПараметрыЗапроса = Новый Структура;
	тПараметрыЗапроса.Вставить("ПериодОт", ПериодОт); 
	тПараметрыЗапроса.Вставить("ПериодДо", ПериодДо);
	тПараметрыЗапроса.Вставить("ДатаСозданияОт", ПериодОт); 
	тПараметрыЗапроса.Вставить("ДатаСозданияДо", ПериодДо); 
	
	Сообщить("================ Время начала - " + Строка(ТекущаяДатаСеанса()) + " ================ ");
	
	тОшибокУдаленияДокументов = 0;
	тОшибокУдаленияСправочников = 0;
	тОшибокУдаленияРегистров = 0;
	
	тОшибокЗаписиДокументов = 0;
	тОшибокЗаписиСправочников = 0;
	тОшибокЗаписиРегистров = 0;
	
	тОшибокУдаленияТабЧастейДокументов = 0;
	тОшибокУдаленияТабЧастейСправочников = 0;
	
	тОшибокЗаписиТабЧастейДокументов = 0;
	тОшибокЗаписиТабЧастейСправочников = 0;
	
	Если Метаданные.РегистрыСведений.Содержит(МассивМетаданных[0]) ИЛИ Метаданные.РегистрыНакопления.Содержит(МассивМетаданных[0]) Тогда // Регистры
		
		#Область Регистры
		Для Каждого тРегистрМД Из МассивМетаданных Цикл 
			тСчетчик = 0;
			
			ПолныйМассивДанных = КХ_ПолучитьДанныеРегистровИзБазы_АУ(тРегистрМД, РазмерПачки, тПараметрыЗапроса);
			Если ПолныйМассивДанных.Количество() = 0 Тогда Продолжить; КонецЕсли;
			
			тСчетчик = тСчетчик + ПолныйМассивДанных.Количество();
			
			МассивПачек = РазбитьМассив(ПолныйМассивДанных, РазмерПачки); 
			
			Для Каждого тМассив Из МассивПачек Цикл
				СтрокаJSONСсылки = КХ_СформироватьJSON(тМассив);
				
				Если Метаданные.РегистрыСведений.Содержит(тРегистрМД) Тогда
					ИмяОсновнойТаблицы = "mega.registr_svedeniy_" + КХ_ТранслитерироватьСтроку(тРегистрМД.Имя);
				ИначеЕсли Метаданные.РегистрыНакопления.Содержит(тРегистрМД) Тогда
					ИмяОсновнойТаблицы = "mega.registr_nakopleniya_" + КХ_ТранслитерироватьСтроку(тРегистрМД.Имя);
				КонецЕсли;
				
				ПолеОтбора = "registrator";
				КодСостоянияОтветаУдаление = КХ_УдалитьДанные(тМассив, ИмяОсновнойТаблицы, ПолеОтбора);
				Если КодСостоянияОтветаУдаление = 200 Тогда 
					КодСостоянияОтвета = КХ_ОтправитьДанные(СтрокаJSONСсылки, ИмяОсновнойТаблицы);
					Если КодСостоянияОтвета <> 200 Тогда
						тОшибокЗаписиРегистров = тОшибокЗаписиРегистров + 1;
						Продолжить; 
					КонецЕсли;
				Иначе
					тОшибокУдаленияРегистров = тОшибокУдаленияРегистров + 1;
					Продолжить;
				КонецЕсли;
			КонецЦикла;
			Сообщить(Строка(тРегистрМД) + " - загружено - " + Строка(тСчетчик));
		КонецЦикла;
		#КонецОбласти
		
	ИначеЕсли Метаданные.Справочники.Содержит(МассивМетаданных[0]) Тогда // Справочники
		
		#Область Справочники
		Для Каждого тСправочникМД Из МассивМетаданных Цикл 
			тСчетчик = 0;
			
			ПолныйМассивСтруктурСсылок = КХ_ПолучитьСсылкиИзБазы_АУ(тСправочникМД, тПараметрыЗапроса);
			Если ПолныйМассивСтруктурСсылок.Количество() = 0 Тогда Продолжить; КонецЕсли;
			
			МассивПачек = РазбитьМассив(ПолныйМассивСтруктурСсылок, РазмерПачки); 
			Для Каждого тМассив Из МассивПачек Цикл
				
				ИмяОсновнойТаблицы = "mega.spravochnik_" + КХ_ТранслитерироватьСтроку(тСправочникМД.Имя);
				
				ПолеОтбора = "ssylka";
				КодСостоянияОтветаУдаление = КХ_УдалитьДанные(тМассив, ИмяОсновнойТаблицы, ПолеОтбора);
				
				Если КодСостоянияОтветаУдаление = 200  Тогда 
					МассивСсылок = МассивСтруктурСсылокВМассивСсылок(тМассив);
					
					ПолныйМассивДанных = КХ_ПолучитьДанныеСправочниковИДокументовИзБазы_АУ(МассивСсылок, тСправочникМД);
					
					тСчетчик = тСчетчик + ПолныйМассивДанных.Количество();
					
					СтрокаJSONДанные = КХ_СформироватьJSON(ПолныйМассивДанных);
					ИмяОсновнойТаблицы = "mega.spravochnik_" + КХ_ТранслитерироватьСтроку(тСправочникМД.Имя);
					КодСостоянияОтвета = КХ_ОтправитьДанные(СтрокаJSONДанные, ИмяОсновнойТаблицы);
					Если КодСостоянияОтвета <> 200 Тогда 
						тОшибокЗаписиСправочников = тОшибокЗаписиСправочников + 1;
						Продолжить; 
					КонецЕсли;
					
					Для Каждого ТЧ Из тСправочникМД.ТабличныеЧасти Цикл
						ИмяТаблицыТЧ = "mega.spravochnik_" + КХ_ТранслитерироватьСтроку(тСправочникМД.Имя) + "_" + КХ_ТранслитерироватьСтроку(ТЧ.Имя);
						ПолеОтбора = "ssylka";
						КодСостоянияОтветаУдалениеТЧ = КХ_УдалитьДанные(тМассив, ИмяТаблицыТЧ, ПолеОтбора);
						Если КодСостоянияОтветаУдалениеТЧ = 200  Тогда 
							ПолныйМассивДанныхТЧ = КХ_ПолучитьДанныеТЧИзБазы(МассивСсылок, тСправочникМД, ТЧ);
							СтрокаJSONДанныеТЧ = КХ_СформироватьJSON(ПолныйМассивДанныхТЧ);
							КодСостоянияОтветаТЧ = КХ_ОтправитьДанные(СтрокаJSONДанныеТЧ, ИмяТаблицыТЧ);
							Если КодСостоянияОтветаТЧ <> 200 Тогда 
								тОшибокЗаписиТабЧастейСправочников = тОшибокЗаписиТабЧастейСправочников + 1;
								Продолжить; 
							КонецЕсли;
							
						Иначе
							тОшибокУдаленияТабЧастейСправочников = тОшибокУдаленияТабЧастейСправочников + 1;
							ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("ОбщийМодуль.ВыгрузкаКликхаус.КХ_УдалитьДанные()",
							УровеньЖурналаРегистрации.Ошибка,,"КодСостоянияОтветаУдалениеТЧ = " + Строка(КодСостоянияОтветаУдалениеТЧ), "Новые данные не загружены в таблицу - " + ИмяТаблицыТЧ);
							//Продолжить;
						КонецЕсли;
					КонецЦикла;
				Иначе
					тОшибокУдаленияСправочников = тОшибокУдаленияСправочников + 1;
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("ОбщийМодуль.ВыгрузкаКликхаус.КХ_УдалитьДанные()",
					УровеньЖурналаРегистрации.Ошибка,,"КодСостоянияОтветаУдаление = " + Строка(КодСостоянияОтветаУдаление), "Новые данные не загружены в таблицу - " + ИмяОсновнойТаблицы);
					//Продолжить;
				КонецЕсли;
			КонецЦикла;
			Сообщить(Строка(тСправочникМД) + " - загружено - " + Строка(тСчетчик));
		КонецЦикла;
		#КонецОбласти
		
	ИначеЕсли Метаданные.Документы.Содержит(МассивМетаданных[0]) Тогда // Документы
		
		#Область Документы
		Для Каждого тДокументМД Из МассивМетаданных Цикл 
			тСчетчик = 0;
			
			ПолныйМассивСтруктурСсылок = КХ_ПолучитьСсылкиИзБазы_АУ(тДокументМД, тПараметрыЗапроса);
			Если ПолныйМассивСтруктурСсылок.Количество() = 0 Тогда Продолжить; КонецЕсли;
			МассивПачек = РазбитьМассив(ПолныйМассивСтруктурСсылок, РазмерПачки); 
			Для Каждого тМассив Из МассивПачек Цикл
				
				ИмяОсновнойТаблицы = "mega.dokument_" + КХ_ТранслитерироватьСтроку(тДокументМД.Имя);
				ПолеОтбора = "ssylka";
				КодСостоянияОтветаУдаление = КХ_УдалитьДанные(тМассив, ИмяОсновнойТаблицы, ПолеОтбора);
				
				Если КодСостоянияОтветаУдаление = 200  Тогда 
					МассивСсылок = МассивСтруктурСсылокВМассивСсылок(тМассив);
					
					ПолныйМассивДанных = КХ_ПолучитьДанныеСправочниковИДокументовИзБазы_АУ(МассивСсылок, тДокументМД);
					
					тСчетчик = тСчетчик + ПолныйМассивДанных.Количество();
					
					СтрокаJSONДанные = КХ_СформироватьJSON(ПолныйМассивДанных);
					ИмяОсновнойТаблицы = "mega.dokument_" + КХ_ТранслитерироватьСтроку(тДокументМД.Имя);
					КодСостоянияОтвета = КХ_ОтправитьДанные(СтрокаJSONДанные, ИмяОсновнойТаблицы);
					Если КодСостоянияОтвета <> 200 Тогда
						тОшибокЗаписиДокументов = тОшибокЗаписиДокументов + 1;
						Попытка
							Файл = Новый ЗаписьТекста("C:\temp\Выгрузка Кликхаус.json", КодировкаТекста.UTF8);
							Файл.ЗаписатьСтроку(СтрокаJSONДанные);
							Файл.Закрыть();
						Исключение
							// игнорируем
						КонецПопытки;
						Продолжить; 
					КонецЕсли;
					
					Для Каждого ТЧ Из тДокументМД.ТабличныеЧасти Цикл
						ИмяТаблицыТЧ = "mega.dokument_" + КХ_ТранслитерироватьСтроку(тДокументМД.Имя) + "_" + КХ_ТранслитерироватьСтроку(ТЧ.Имя);
						ПолеОтбора = "ssylka";
						КодСостоянияОтветаУдалениеТЧ = КХ_УдалитьДанные(тМассив, ИмяТаблицыТЧ, ПолеОтбора);
						Если КодСостоянияОтветаУдалениеТЧ = 200  Тогда 
							ПолныйМассивДанныхТЧ = КХ_ПолучитьДанныеТЧИзБазы(МассивСсылок, тДокументМД, ТЧ);
