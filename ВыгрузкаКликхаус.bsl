
#Область РегламентныеЗадания

&НаСервере
Процедура Выгрузка_День_Документы_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт
	
	РазмерПачки = 5000;
	
	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;
	
	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;
	
	тМассивМетаданныхОтправляемыхДокументов = КХ_ПолучитьМассивМетаданныхОтправляемыхДокументов();
	Если тМассивМетаданныхОтправляемыхДокументов.Количество() > 0 Тогда КХ_Загрузить_из_ОС(тМассивМетаданныхОтправляемыхДокументов, ПериодОт, ПериодДо, РазмерПачки); КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Выгрузка_День_Справочники_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт	
	
	РазмерПачки = 5000;
	
	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;
	
	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;
	
	тМассивМетаданныхОтправляемыхСправочников = КХ_ПолучитьМассивМетаданныхОтправляемыхСправочников();
	Если тМассивМетаданныхОтправляемыхСправочников.Количество() > 0 Тогда КХ_Загрузить_из_ОС(тМассивМетаданныхОтправляемыхСправочников, ПериодОт, ПериодДо, РазмерПачки); КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура Выгрузка_День_Регистры_ОС(Знач ПериодОт = Неопределено, Знач ПериодДо = Неопределено) Экспорт
	
	РазмерПачки = 5000;
	
	Если ПериодОт = Неопределено Тогда
		ПериодОт = НачалоДня(ТекущаяДатаСеанса() - 60*60*24*7); // минус 7 дней
	КонецЕсли;
	
	Если ПериодДо = Неопределено Тогда
		ПериодДо = КонецДня(ТекущаяДатаСеанса() - 60*60*24); // вчера
	КонецЕсли;
	
	тМассивМетаданныхОтправляемыхРегистров = КХ_ПолучитьМассивМетаданныхОтправляемыхРегистров();
	Если тМассивМетаданныхОтправляемыхРегистров.Количество() > 0 Тогда КХ_Загрузить_из_ОС(тМассивМетаданныхОтправляемыхРегистров, ПериодОт, ПериодДо, РазмерПачки); КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

